{% extends 'base.html.twig' %}

{% block title %}Nos Pizzas{% endblock %}

{% block body %}
<div class="container">
    <h1>Nos Pizzas</h1>
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
    <a href="#">Voir les conditions</a>

    <hr class="my-4">
    <h2 class="mt-3">La carte</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Nom
                    {% if app.user %}
                        <a class="link-body-emphasis text-decoration-none" href="{{ path('app_pizza_index', app.request.query.all|merge({
                            sort: 'name',
                            direction: 'ASC'
                        })) }}">
                            <i class="bi bi-caret-down-square" width="32" height="32" role="img" aria-label="Bootstrap"></i>
                        </a>
                        <span> </span>
                        <a class="link-body-emphasis text-decoration-none" href="{{ path('app_pizza_index', app.request.query.all|merge({
                            sort: 'name',
                            direction: 'DESC'
                        })) }}">
                            <i class="bi bi-caret-up-square" width="32" height="32" role="img" aria-label="Bootstrap"></i>
                        </a>
                    {% endif %}
                </th>
                <th>Ingrédients</th>
                <th>Prix (€)
                    {% if app.user %}
                        <a class="link-body-emphasis text-decoration-none" href="{{ path('app_pizza_index', app.request.query.all|merge({
                            sort: 'price',
                            direction: 'ASC'
                        })) }}">
                            <i class="bi bi-caret-down-square" width="32" height="32" role="img" aria-label="Bootstrap"></i>
                        </a>
                        <span> </span>
                        <a class="link-body-emphasis text-decoration-none" href="{{ path('app_pizza_index', app.request.query.all|merge({
                            sort: 'price',
                            direction: 'DESC'
                        })) }}">
                            <i class="bi bi-caret-up-square" width="32" height="32" role="img" aria-label="Bootstrap"></i>
                        </a>
                    {% endif %}
                </th>
                {% if app.user %}
                    <th>Visible
                        <a class="link-body-emphasis text-decoration-none" href="{{ path('app_pizza_index', app.request.query.all|merge({
                            sort: 'name',
                            direction: 'ASC'
                        })) }}">
                            <i class="bi bi-caret-down-square" width="32" height="32" role="img" aria-label="Bootstrap"></i>
                        </a>
                        <span> </span>
                        <a class="link-body-emphasis text-decoration-none" href="{{ path('app_pizza_index', app.request.query.all|merge({
                            sort: 'name',
                            direction: 'DESC'
                        })) }}">
                            <i class="bi bi-caret-up-square" width="32" height="32" role="img" aria-label="Bootstrap"></i>
                        </a>
                    </th>
                    <th>Actions</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
        {% for pizza in pizzas %}
            <tr>
                <td>{{ pizza.name }}</td>
                <td>{{ pizza.ingredients }}</td>
                <td>{{ pizza.price }}</td>
                {% if app.user %}
                    <td>{{ pizza.isActive ? 'oui' : 'non' }}</td>
                    <td>
                        <a href="{{ path('app_pizza_show', {'id': pizza.id}) }}">voir</a>
                        <a href="{{ path('app_pizza_edit', {'id': pizza.id}) }}">modifier</a>
                    </td>
                {% endif %}
            </tr>
        {% else %}
            <tr>
                {% if app.user %}
                    <td colspan="5">Pas de pizzas disponibles</td>
                {% else %}
                    <td colspan="3">Pas de pizzas disponibles</td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if app.user %}
        <form class="mb-2" method="get" onchange="this.submit()">
            <div>
                <label for="showActive" class="required">Visibilité des pizzas</label>
                <select name="showActive">
                    <option value="2" {{ app.request.query.get('showActive') == '2' ? 'selected' : '' }}>Toutes</option>
                    <option value="1" {{ app.request.query.get('showActive') == '1' ? 'selected' : '' }}>Seulement visibles</option>
                    <option value="0" {{ app.request.query.get('showActive') == '0' ? 'selected' : '' }}>Seulement non visibles</option>
                </select>
            </div>
        </form>

        <a href="{{ path('app_pizza_new') }}">Créer une pizza</a>
    {% endif %}

    <hr class="my-4">
    <h2 class="mt-3">Notre service de réservation</h2>
    {% if services is empty %}
        <p>Aucun service n'est disponible pour le moment.</p>
    {% else %}
        <form method="post" class="needs-validation" novalidate="">
            <div class="row g-3">
                <h3>Nos disponibilités</h3>
                <div class="col-md-4"> 
                    <label class="form-label required" for="serviceDate">Nos services disponibles</label>
                    <select class="form-select" name="serviceDate" id="serviceDate">
                        {% for service in services %}
                            <option value="{{ service.id }}">{{ service.serviceDate|format_datetime(pattern: 'EEEE d MMMM',locale: 'fr') }} ({{ service.template.startTime|date('H:i') }} - {{ service.template.endTime|date('H:i') }})</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4"> 
                    <label class="form-label required" for="serviceSlot">Choisissez votre horaire</label>
                    <select class="form-select" name="serviceSlot" id="serviceSlot">
                        {% for service in services %}
                            <option value="{{ service.id }}">--- 19:55 (3 pizzas restantes) ---</option>
                        {% endfor %}
                    </select>
                </div>
                <hr class="my-2">
                <h3>Votre panier</h3>


                <table class="table">
                    <thead>
                        <tr>
                            <th>Pizza</th>
                            <th>Quantité</th>
                            <th>Prix unitaire</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="cartBody">
                        <tr id="noItems">
                            <td colspan="6" class="text-muted">
                                Aucune pizza ajoutée.
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="text-end">
                    <span id="cartTotalQuantity">0</span> pizza(s) dans le panier. <br>
                    <strong>Total : <span id="cartTotal">0,00</span> €</strong>
                </div>
                <p class="alert alert-warning d-none" id="capacityAlert">
                    La capacité disponible pour ce créneau horaire est atteinte. Vous pouvez passer commande en l'état mais pas ajouter de pizza.<br>Le cas échéant, veuillez choisir un autre créneau, passer plusieurs commandes ou bien contactez-nous par téléphone.
                </p>

                <div class="col-md-6"> 
                    <label class="form-label required" for="pizza">Votre pizza</label>
                    <select class="form-select" name="pizza" id="pizza">
                        {% for pizza in pizzas %}
                            <option value="{{ pizza.id }}" data-name="{{ pizza.name }}" data-price="{{ pizza.price }}">
                                {{ pizza.name }} ({{ pizza.price }} €)
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2"> 
                    <label class="form-label required" for="quantity">Quantité</label>
                    <select class="form-select" name="quantity" id="quantity">
                        {% for i in 1..5 %}
                            <option value="{{ i }}">{{ i }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3 align-content-end"> 
                    <button type="button" id="addPizza" class="btn btn-primary">Ajouter au panier</button>
                </div>


                <hr class="my-2">
                <h3>Vos coordonnées</h3>
                <div class="col-sm-6">
                    <label for="firstName" class="form-label">Prénom</label> 
                    <input type="text" class="form-control" id="firstName" placeholder="" value="" required="">
                    <div class="invalid-feedback">
                        Un prénom valide est requis.
                    </div>
                </div>
                <div class="col-sm-6">
                    <label for="lastName" class="form-label">Nom</label>
                    <input type="text" class="form-control" id="lastName" placeholder="" value="" required="">
                    <div class="invalid-feedback">
                        Un nom valide est requis.
                    </div>
                </div>
                <div class="col-7">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" placeholder="mail@mail.com">
                    <div class="invalid-feedback">
                        Veuillez entrer une adresse email valide.
                    </div>
                </div>
                <div class="col-5">
                    <label for="phone" class="form-label">Téléphone</label>
                    <input type="tel" class="form-control" id="phone" placeholder="0600000000" pattern="0[1-7](?: [0-9]{2}){4}">
                    <div class="invalid-feedback">
                        Veuillez entrer un numéro de téléphone valide.
                    </div>
                </div>
                <hr class="my-4">
            </div>
            <input type="hidden" name="_token" {# value="{{ csrf_token('delete' ~ pizza.id) }}" #}> 
            <div class="d-flex justify-content-center">
                <button class="btn btn-primary">Réserver</button>
            </div>
            <hr class="my-4">
        </form>
    {% endif %}

</div>
{% endblock %}

