{% extends 'base.html.twig' %}

{% block title %}Service de Pizza{% endblock %}

{% block body %}
    <h1>Nos services de pizza</h1>

    <table class="table">
        <thead>
            <tr>
                {# <th>Date de service</th>
                <th>Début service</th>
                <th>Fin service</th> #}
                <th>Service</th>
                <th>Créneau (min.)</th>
                <th>Capacité</th>
                <th>Réservation ouverte</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for pizza_service in pizza_services %}
            <tr>
                {# <td>{{ pizza_service.serviceDate|date('Y-m-d') }}</td>
                <td>{{ pizza_service.startTime|date('H:i') }}</td>
                <td>{{ pizza_service.endTime|date('H:i') }}</td> #}
                <td>
                    {{ pizza_service.serviceDate|format_datetime(pattern: 'd MMMM',locale: 'fr') }} 
                    ({{ pizza_service.startTime|date('H:i') }} - 
                    {{ pizza_service.endTime|date('H:i') }})
                </td>
                <td>{{ pizza_service.slotDurationInMin }}</td>
                <td>{{ pizza_service.capacityPerSlot }}</td>
                <td>{{ pizza_service.bookingOpen ? 'oui' : 'non' }}</td>
                <td>
                    <a href="{{ path('app_pizza_service_show', {'id': pizza_service.id}) }}">Voir</a>
                    <a href="{{ path('app_pizza_service_edit', {'id': pizza_service.id}) }}">Modifier</a>
                    <a href="{{ path('app_slot_show_services_slots', {'id': pizza_service.id}) }}">Créneaux</a>
                    <a href="{{ path('app_reservation_service', {'id': pizza_service.id}) }}">Réservations</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Pas de services de pizza disponibles</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_pizza_service_new') }}">Créer un service</a>
{% endblock %}
