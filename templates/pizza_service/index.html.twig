{% extends 'base.html.twig' %}

{% block title %}Service de Pizza{% endblock %}

{% block body %}
    <h1>Nos services de pizza</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Date de service</th>
                <th>Début service</th>
                <th>Fin service</th>
                <th>Durée créneau (min.)</th>
                <th>Capacité créneau</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for pizza_service in pizza_services %}
            <tr>
                <td>{{ pizza_service.serviceDate|date('Y-m-d') }}</td>
                <td>{{ pizza_service.template.startTime|date('H:i') }}</td>
                <td>{{ pizza_service.template.endTime|date('H:i') }}</td>
                <td>{{ pizza_service.template.slotDurationInMin }}</td>
                <td>{{ pizza_service.template.capacityPerSlot }}</td>
                <td>
                    <a href="{{ path('app_pizza_service_show', {'id': pizza_service.id}) }}">Voir</a>
                    <a href="{{ path('app_pizza_service_edit', {'id': pizza_service.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Pas de services de pizza disponibles</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_pizza_service_new') }}">Créer un service</a>
{% endblock %}
