{% extends 'base.html.twig' %}

{% block title %}Service de Pizza{% endblock %}

{% block body %}
    <h1>Service de Pizza</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Date de service</th>
                <td>{{ pizza_service.serviceDate|date('Y-m-d') }}</td>
            </tr>
            <tr>
                <th>Début service</th>
                <td>{{ pizza_service.startTime|date('H:i') }}</td>
            </tr>
            <tr>
                <th>Fin service</th>
                <td>{{ pizza_service.endTime|date('H:i') }}</td>
            </tr>
            <tr>
                <th>Durée créneau (min.)</th>
                <td>{{ pizza_service.slotDurationInMin }}</td>
            </tr>
            <tr>
                <th>Capacité créneau</th>
                <td>{{ pizza_service.capacityPerSlot }}</td>
            </tr>
            <tr>
                <th>Réservation ouverte</th>
                <td>{{ pizza_service.bookingOpen ? 'oui' : 'non' }}</td>
            </tr>
            <tr>
                <th>Modèle d'origine (informatif)</th>
                <td>{{ pizza_service.template.name }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_pizza_service_edit', {'id': pizza_service.id}) }}">Modifier</a>
    <a href="{{ path('app_slot_show_services_slots', {'id': pizza_service.id}) }}">Créneaux attachés</a>
    <a href="{{ path('app_pizza_service_index') }}">Retour à la liste des services</a>

    {{ include('pizza_service/_delete_form.html.twig') }}
{% endblock %}
