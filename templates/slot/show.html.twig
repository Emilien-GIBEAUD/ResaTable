{% extends 'base.html.twig' %}

{% block title %}PizzaServiceSlot{% endblock %}

{% block body %}
    <h1>PizzaServiceSlot</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ pizza_service_slot.id }}</td>
            </tr>
            <tr>
                <th>StartTime</th>
                <td>{{ pizza_service_slot.startTime ? pizza_service_slot.startTime|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Capacity</th>
                <td>{{ pizza_service_slot.capacity }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ pizza_service_slot.createdAt ? pizza_service_slot.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ pizza_service_slot.updatedAt ? pizza_service_slot.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_slot_index') }}">back to list</a>

    <a href="{{ path('app_slot_edit', {'id': pizza_service_slot.id}) }}">edit</a>

    {{ include('slot/_delete_form.html.twig') }}
{% endblock %}
