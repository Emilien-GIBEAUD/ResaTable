###> symfony/framework-bundle ###
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
MARIADB_DATABASE=sf_ResaTable
MARIADB_VERSION=12.3.2
MARIADB_USER=your_user_here             # Avoid a Warning when Symfony commands are used. DO NOT WRITE YOUR SECRETS IN THIS FILE, USE .env.dev.local INSTEAD (see .env.dev.exemple).
MARIADB_PASSWORD=your_password_here     # Avoid a Warning when Symfony commands are used. DO NOT WRITE YOUR SECRETS IN THIS FILE, USE .env.dev.local INSTEAD (see .env.dev.exemple).

DATABASE_URL="mysql://${MARIADB_USER}:${MARIADB_PASSWORD}@database:3306/${MARIADB_DATABASE}?serverVersion=${MARIADB_VERSION}-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

# To define a custom servername for local development (default is "localhost")
SERVER_NAME=rt.localhost

APP_BASE_URL=https://rt.localhost

###> symfony/mailer ###
MAILER_DSN=null:null
###< symfony/mailer ###

###> symfony/brevo-mailer ###
# MAILER_DSN=brevo+api://KEY@default
# MAILER_DSN=brevo+smtp://USERNAME:PASSWORD@default
###< symfony/brevo-mailer ###
